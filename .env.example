# Subfolder hosting path (contoh: /ai-grader untuk https://app.wmvaa.id/ai-grader)
NEXT_PUBLIC_BASE_PATH=/ai-grader

GOOGLE_APPLICATION_CREDENTIALS=./supabase-auth-480321-4f0aeef2cb76.json
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
GEMINI_API_KEY=your-gemini-api-key

# Wajib untuk production. Minimal 32 karakter acak.
SESSION_SECRET=replace-with-a-strong-random-secret-of-at-least-32-characters

# Endpoint /api/setup otomatis ditutup di production.
# Buka hanya sementara saat onboarding awal.
ALLOW_RUNTIME_SETUP=false

# Bootstrap akun pertama di production.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
BOOTSTRAP_ADMIN_NAME=Administrator

# Opsional untuk emergency reset admin.
# Jika kosong, sistem akan membuat password sementara acak yang kuat.
EMERGENCY_ADMIN_RESET_PASSWORD=
